# コピーして .env を作成してください（.env は git 管理外です）。APIキーをソースコードに書かないでください。

# --- 台本生成 (LLM) ---
# auto: claude CLI -> Anthropic API(有料・要許可) -> オフラインテンプレート
AIVIDEO_LLM=auto
# Anthropic API を使う場合のみ設定（有料）。AIVIDEO_ALLOW_PAID=1 も必要。
ANTHROPIC_API_KEY=
AIVIDEO_ALLOW_PAID=0
AIVIDEO_CLAUDE_MODEL=claude-opus-5-5

# --- 映像 ---
# auto: pollinations(無料AI画像) -> イラスト(Noto Emoji) -> オフライン生成グラフィック
AIVIDEO_VISUALS=auto
# AI画像を何シーンに1回使うか (無料枠は45秒に1枚。1にすると全シーンAI画像だが時間がかかる)
AIVIDEO_AI_EVERY=2

# --- 台本の語り口 (空ならやさしく親しみやすい語り口) ---
AIVIDEO_TONE=

# --- 音声 ---
# Open JTalk の声: happy (明るく柔らかい・既定) / normal / bashful (ささやき系・ゆっくり)
AIVIDEO_VOICE=happy
# auto: voicevox(ローカルで起動していれば) -> openjtalk
AIVIDEO_TTS=auto
VOICEVOX_URL=http://127.0.0.1:50021
# 話者 ID。柔らかい声のおすすめ: 8=春日部つむぎ / 14=冥鳴ひまり / 0=四国めたん(あまあま) / 13=青山龍星(男性)
VOICEVOX_SPEAKER=8
# VOICEVOX ENGINE を展開したフォルダ。設定すると動画作成時に自動で起動します
VOICEVOX_ENGINE_DIR=

# チャンネル名（台本の挨拶で使用。空なら名乗らない）
AIVIDEO_CHANNEL_NAME=
